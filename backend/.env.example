# Tribely Backend Environment Configuration
PROJECT_NAME=Tribely
SECRET_KEY=change_this_to_a_secure_random_64_character_hex_string_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Database Settings
POSTGRES_SERVER=127.0.0.1
POSTGRES_HOST=127.0.0.1
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tribely_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tribely_db

# Redis Cache & PubSub Settings
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=

# Frontend Application URL (for invite links and CORS)
FRONTEND_URL=https://tribely.mayurkpatil.in

# Supabase Storage Integration (Server-Side Only - NEVER expose service role key to client)
STORAGE_PROVIDER=local
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_STORAGE_BUCKET=tribely-proofs

# Google Gemini Vision API (Optional - Auto-Verification Falls Back to Deterministic Heuristics if unset)
GEMINI_API_KEY=

# Razorpay API Credentials (Optional Staking Integration)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=


