# Tribely Backend Environment Configuration
PROJECT_NAME=Tribely
SECRET_KEY=change_this_to_a_secure_random_64_character_hex_string_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Database Settings
POSTGRES_SERVER=127.0.0.1
POSTGRES_HOST=127.0.0.1
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tribely_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tribely_db

# Redis Cache & PubSub Settings
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
