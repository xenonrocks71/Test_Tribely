# Project Tribely - Production Environment Configuration Template

# --- DATABASE CONFIGURATION ---
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=tribely_prod_user
POSTGRES_PASSWORD=super_secure_production_password_change_me
POSTGRES_DB=tribely_production_db

# --- REDIS CONFIGURATION ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=optional_redis_cluster_password

# --- SECURITY & AUTHENTICATION ---
SECRET_KEY=generate_a_64_character_hex_jwt_secret_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALGORITHM=HS256

# --- CORS & DOMAINS ---
CORS_ORIGINS=["https://app.tribely.com", "https://api.tribely.com"]
ALLOWED_HOSTS=["app.tribely.com", "api.tribely.com"]

# --- FRONTEND ENVIRONMENT VARIABLES ---
NEXT_PUBLIC_API_URL=https://api.tribely.com
NEXT_PUBLIC_WS_URL=wss://api.tribely.com
