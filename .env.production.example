# Project Tribely - Production Environment Configuration Template
# Frontend -> Vercel (tribely.mayurkpatil.in)
# Backend  -> Render (tribely-backend.onrender.com)
# Database -> Supabase PostgreSQL
# Redis    -> Free Redis Service (Upstash / Render Redis)
# Media    -> Supabase Storage

# --- BACKEND ENVIRONMENT VARIABLES (Configure in Render Dashboard) ---
ENVIRONMENT=production
PROJECT_NAME=Tribely
PORT=8000
SECRET_KEY=generate_a_64_character_hex_jwt_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database: Supabase PostgreSQL Connection String (Transaction mode pooler or direct)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.your_supabase_ref:your_password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# Redis: Remote Redis Connection String (e.g. Upstash rediss:// or Render Redis)
REDIS_URL=rediss://default:your_redis_token@your-redis.upstash.io:6379

# Frontend & CORS Configuration
FRONTEND_URL=https://tribely.mayurkpatil.in
CORS_ORIGINS=["https://tribely.mayurkpatil.in", "https://tribely-backend.onrender.com"]

# Supabase Storage Integration (Server-Side Only - NEVER expose to browser)
STORAGE_PROVIDER=supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key
SUPABASE_STORAGE_BUCKET=tribely-proofs

# Optional: Google Gemini Vision API for Multimodal Proof Verification (falls back to deterministic heuristics)
GEMINI_API_KEY=

# --- FRONTEND ENVIRONMENT VARIABLES (Configure in Vercel Dashboard) ---
NEXT_PUBLIC_API_URL=https://tribely-backend.onrender.com
NEXT_PUBLIC_WS_URL=wss://tribely-backend.onrender.com
NEXT_PUBLIC_APP_URL=https://tribely.mayurkpatil.in

